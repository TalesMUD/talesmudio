---
import Landing from '../../layouts/Landing.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: 'introducing-talesmud',
    title: 'Introducing TalesMUD — A Modern Framework for Browser-Based MUDs',
    date: '2024-12-01',
    readTime: '8 min read',
    excerpt: 'What TalesMUD is, why it exists, and how it brings the classic MUD format into the modern web era with Go, Svelte, and browser-native play.',
    tags: ['announcement', 'framework', 'open-source'],
  },
];
---

<Landing title="Blog — TalesMUD" description="News, updates, and dev stories from the TalesMUD project.">
  <Nav />

  <main style="min-height: calc(100vh - 64px); padding-top: 2rem;">
    <div class="section">
      <div class="section-header">
        <span class="section-eyebrow">Blog</span>
        <h1 class="section-title" style="font-family: var(--font-display); color: var(--color-amber);">From the TalesMUD team</h1>
        <p class="section-desc">Development stories, feature deep-dives, and community highlights.</p>
      </div>

      <div class="blog-list">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="blog-post-card">
            <div class="blog-post-meta">
              <span class="blog-post-date">{post.date}</span>
              <span class="blog-post-sep">·</span>
              <span class="blog-post-readtime">{post.readTime}</span>
            </div>
            <h2 class="blog-post-title">{post.title}</h2>
            <p class="blog-post-excerpt">{post.excerpt}</p>
            <div class="blog-post-tags">
              {post.tags.map(tag => (
                <span class="showcase-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Landing>

<style>
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .blog-post-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .blog-post-card:hover {
    border-color: rgba(245, 166, 35, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  .blog-post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .blog-post-date,
  .blog-post-readtime {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-dim);
  }

  .blog-post-sep {
    color: var(--color-border);
  }

  .blog-post-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .blog-post-card:hover .blog-post-title {
    color: var(--color-amber);
  }

  .blog-post-excerpt {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .showcase-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 2px 8px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 4px;
    color: var(--color-teal);
  }
</style>
