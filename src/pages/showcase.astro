---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Landing title="Showcase — TalesMUD" description="MUDs built with TalesMUD framework.">
  <Nav />

  <main class="showcase-main">
    <div class="section">
      <div class="section-header">
        <span class="section-eyebrow">Showcase</span>
        <h1 class="section-title" style="font-family: var(--font-display); color: var(--color-amber);">Games Built with TalesMUD</h1>
        <p class="section-desc">
          These worlds are powered by the TalesMUD framework. Each one is a unique adventure
          built by independent creators.
        </p>
      </div>

      <div class="showcase-grid">
        <!-- Veilspan -->
        <div class="showcase-card">
          <div class="showcase-card-header">
            <div class="showcase-badge active">Active Development</div>
          </div>
          <div class="showcase-card-body">
            <h2 class="showcase-card-title">Veilspan</h2>
            <p class="showcase-card-subtitle">A fantasy adventure in the world of Aethermoor</p>
            <p class="showcase-card-desc">
              Explore the ancient Catacombs beneath a forgotten city. Choose your class,
              uncover the mystery of the Architects, and survive the creatures that lurk
              in the deep. The official demo world for TalesMUD — continuously updated
              with new content.
            </p>
            <div class="showcase-tags">
              <span class="showcase-tag">Fantasy</span>
              <span class="showcase-tag">RPG</span>
              <span class="showcase-tag">Dungeon Crawler</span>
              <span class="showcase-tag">Multiplayer</span>
            </div>
          </div>
          <div class="showcase-card-footer">
            <a href="https://veilspan.com" class="btn btn-primary" target="_blank" rel="noopener">
              Play Now →
            </a>
          </div>
        </div>
      </div>

      <!-- Submit CTA -->
      <div class="submit-cta">
        <div class="submit-cta-inner">
          <h2 class="submit-cta-title">Built something with TalesMUD?</h2>
          <p class="submit-cta-desc">
            Open an issue on GitHub with details about your game and we'll add it to the showcase.
            Include your game's name, URL, description, and any screenshots.
          </p>
          <a href="https://github.com/TalesMUD/talesmud/issues/new" class="btn btn-secondary" target="_blank" rel="noopener">
            Submit Your Game →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Landing>

<style>
  .showcase-main {
    min-height: calc(100vh - 64px);
    padding-top: 2rem;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .showcase-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
  }

  .showcase-card:hover {
    border-color: rgba(245, 166, 35, 0.3);
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  .showcase-card-header {
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.08) 0%, rgba(56, 189, 248, 0.04) 100%);
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem;
    min-height: 120px;
    display: flex;
    align-items: flex-end;
  }

  .showcase-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .showcase-badge.active {
    background: rgba(34, 197, 94, 0.15);
    color: var(--color-emerald);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .showcase-card-body {
    padding: 1.5rem;
    flex: 1;
  }

  .showcase-card-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-amber);
    margin: 0 0 0.25rem;
  }

  .showcase-card-subtitle {
    color: var(--color-teal);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }

  .showcase-card-desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .showcase-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .showcase-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 2px 8px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 4px;
    color: var(--color-teal);
  }

  .showcase-card-footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .submit-cta {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
    text-align: center;
  }

  .submit-cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .submit-cta-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .submit-cta-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }
</style>
